<key>NSSpeechRecognitionUsageDescription</key><string>SolidCraft turns your spoken request into text for the AI window.</string>
<key>UIFileSharingEnabled</key><true/>
<key>LSSupportsOpeningDocumentsInPlace</key><true/>
</dict></plist>
